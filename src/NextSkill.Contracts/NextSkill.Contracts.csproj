<Project Sdk="Microsoft.NET.Sdk">

  <!-- net8.0 is REQUIRED: CounterStrikeSharp runs on .NET 8 and must be able to
       reference this library. Sharing wire DTOs with the plugin is the whole
       reason decision 004 chose C#. Do not drop net8.0. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
