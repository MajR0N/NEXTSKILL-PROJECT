@*
    Layout shell — decisions 018 (server-rendered), 021 (headbar public),
    031 (footer carries obligations, not marketing).

    Progressive enhancement is a hard rule (020): every content page must work
    with JavaScript disabled. A page that renders empty without JS breaks link
    unfurling, which is the growth mechanism (018).
*@
@using System.Globalization
@using NextSkill.Api.Localisation
@{
    // The URL is the source of truth for language (018). RequestLocalization
    // has already resolved it by the time the layout renders.
    var locale = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (!Locales.IsSupported(locale)) { locale = Locales.Default; }
    var title = ViewData["Title"] as string;
    var path = Context.Request.Path.Value ?? "/";
    // Same page, other language — used for both the switcher and hreflang.
    string InLocale(string l)
    {
        var rest = path.StartsWith($"/{locale}", StringComparison.Ordinal)
            ? path[(locale.Length + 1)..]
            : path;
        return $"/{l}{rest}";
    }
}
<!DOCTYPE html>
<html lang="@locale">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(title is null ? "NEXTSKILL" : $"{title} — NEXTSKILL")</title>

    @* Open Graph is a design surface, not an afterthought: growth runs through
       links pasted into Discord and forums, and those crawlers do not run JS. *@
    <meta property="og:site_name" content="NEXTSKILL" />
    <meta property="og:title" content="@(title ?? "NEXTSKILL")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Platforma turniejowa dla sceny CS 1.6 i CS2.")" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@Locales.OpenGraph(locale)" />

    @* hreflang tells search engines which language each URL serves, so the
       right one is offered to the right reader (018). *@
    @foreach (var l in Locales.Supported)
    {
        <link rel="alternate" hreflang="@l" href="@InLocale(l)" />
    }

    @* .NET 10 fingerprints static assets automatically via MapStaticAssets,
       so asp-append-version is redundant here. *@
    <link rel="stylesheet" href="~/css/nextskill.css" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <a class="visually-hidden" href="#main">Przejdź do treści</a>

    <header class="wrap">
        <nav class="headbar">
            <a class="brand" asp-page="/Index">next<b>skill</b></a>
            <a asp-page="/Ranking/Index">Ranking</a>
            <a asp-page="/Index">Turnieje</a>
            <a asp-page="/Index">Mecze</a>
            <a asp-page="/Index">Szukam drużyny</a>
            <span class="headbar__spacer"></span>
            @* Locale switcher stays visible — a Russian speaker landing on a
               Polish page must be able to fix that immediately (018). *@
            <div class="locale">
                @foreach (var l in Locales.Supported)
                {
                    <a href="@InLocale(l)" hreflang="@l" aria-current="@(l == locale ? "true" : "false")">@l.ToUpperInvariant()</a>
                }
            </div>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="wrap footer">
        <div class="footer__cols">
            <div>
                <h4>NEXTSKILL</h4>
                <p class="dim" style="font-size:13px;margin:0">Platforma turniejowa dla sceny CS&nbsp;1.6 i CS2.</p>
            </div>
            <div>
                <h4>Turnieje</h4>
                <a href="#">Ranking</a><a href="#">Turnieje</a><a href="#">Szukam drużyny</a><a href="#">Archiwum sezonów</a>
            </div>
            <div>
                <h4>Społeczność</h4>
                <a href="#">Discord</a><a href="#">Forum</a><a href="#">Regulamin</a><a href="#">FAQ</a>
            </div>
        </div>
        <div class="footer__bottom">
            <span>Prywatność · Warunki · Kontakt</span>
            <span>PL EN RU DE</span>
            @* Version makes "which version were you on?" answerable in support
               and confirms a deploy landed (017). *@
            <span>v@(ViewData["Version"] ?? "0.1.0-dev")</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
