@*
    Layout shell — decisions 018 (server-rendered), 021 (headbar public),
    031 (footer carries obligations, not marketing).

    Progressive enhancement is a hard rule (020): every content page must work
    with JavaScript disabled. A page that renders empty without JS breaks link
    unfurling, which is the growth mechanism (018).
*@
@using System.Globalization
@using Microsoft.Extensions.Localization
@using NextSkill.Api.Localisation
@using NextSkill.Api.Features.Notifications
@using NextSkill.Api.Features.Panels
@inject IStringLocalizer<UiText> Text
@inject NotificationBell Bell
@inject PanelLinks Panels
@{
    // The URL is the source of truth for language (018). RequestLocalization
    // has already resolved it by the time the layout renders.
    var locale = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (!Locales.IsSupported(locale)) { locale = Locales.Default; }
    var title = ViewData["Title"] as string;
    var path = Context.Request.Path.Value ?? "/";
    // Same page, other language — used for both the switcher and hreflang.
    string InLocale(string l)
    {
        var rest = path.StartsWith($"/{locale}", StringComparison.Ordinal)
            ? path[(locale.Length + 1)..]
            : path;
        return $"/{l}{rest}";
    }
}
<!DOCTYPE html>
<html lang="@locale">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(title is null ? "NEXTSKILL" : $"{title} — NEXTSKILL")</title>

    @* Open Graph is a design surface, not an afterthought: growth runs through
       links pasted into Discord and forums, and those crawlers do not run JS. *@
    <meta property="og:site_name" content="NEXTSKILL" />
    <meta property="og:title" content="@(title ?? "NEXTSKILL")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? Text["Meta.Description"].Value)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@Locales.OpenGraph(locale)" />

    @* hreflang tells search engines which language each URL serves, so the
       right one is offered to the right reader (018). *@
    @foreach (var l in Locales.Supported)
    {
        <link rel="alternate" hreflang="@l" href="@InLocale(l)" />
    }

    @* .NET 10 fingerprints static assets automatically via MapStaticAssets,
       so asp-append-version is redundant here. *@
    <link rel="stylesheet" href="~/css/nextskill.css" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <a class="visually-hidden" href="#main">@Text["Accessibility.SkipToContent"]</a>

    <header class="wrap">
        <nav class="headbar">
            @* asp-route-culture is NOT optional. Ambient route values are only
               reused for links to the SAME page, so a cross-page link without it
               silently drops the locale — a German reader clicking "Ranking"
               would land back in Polish (018). *@
            <a class="brand" asp-page="/Index" asp-route-culture="@locale">next<b>skill</b></a>
            <a asp-page="/Ranking/Index" asp-route-culture="@locale">@Text["Navigation.Ranking"]</a>
            <a asp-page="/Teams/Index" asp-route-culture="@locale">@Text["Navigation.Teams"]</a>
            <a asp-page="/Tournaments/Index" asp-route-culture="@locale">@Text["Navigation.Tournaments"]</a>
            <a asp-page="/Index" asp-route-culture="@locale">@Text["Navigation.Matches"]</a>
            <a asp-page="/Lft/Index" asp-route-culture="@locale">@Text["Navigation.Lft"]</a>
            <span class="headbar__spacer"></span>

            @* One search box, and it is a plain GET form. Typeahead is a Phase 5
               island on top of this, never instead of it (018, 043). *@
            <form method="get" action="/@locale/search" role="search" style="display:inline">
                <label class="visually-hidden" for="headbar-search">@Text["Search.Label"]</label>
                <input id="headbar-search" name="q" maxlength="60" placeholder="@Text["Search.Label"]"
                       style="padding:6px 10px;font-size:13px;width:150px" />
            </form>

            @if (User.Identity?.IsAuthenticated == true)
            {
                @* Server-rendered, because 018 makes working without JavaScript
                   a hard rule — a count that needs a script is absent exactly
                   where it matters. Polling is a Phase 5 enhancement on a number
                   that is already right. *@
                var unread = await Bell.UnreadCountAsync(User);
                <a asp-page="/Notifications/Index" asp-route-culture="@locale"
                   aria-label="@Text["Notifications.Aria", unread]">
                    @Text["Notifications.Bell"]@(unread > 0 ? $" ({unread})" : "")
                </a>
                @* The panel had nine working pages and no link to any of them.
                   Shown only to somebody who can actually reach one, because a
                   link that 403s is worse than no link (036). *@
                @if (await Panels.EntryAsync(User, locale) is { } panelEntry)
                {
                    <a href="@panelEntry">@Text["Panel.Title"]</a>
                }
                <a asp-page="/Account/Profile" asp-route-culture="@locale">@User.Identity.Name</a>
                @* Logout is a POST, so it cannot be triggered by an <img src> on
                   someone else's page — and Razor Pages signs the form for us. *@
                <form method="post" asp-page="/Account/Logout" asp-route-culture="@locale" style="display:inline">
                    <button class="btn btn--ghost" type="submit" style="padding:6px 12px;font-size:13px">@Text["Account.Logout"]</button>
                </form>
            }
            else
            {
                <a asp-page="/Account/Login" asp-route-culture="@locale">@Text["Account.Login"]</a>
                <a class="btn btn--primary" asp-page="/Account/Register" asp-route-culture="@locale"
                   style="padding:7px 14px;font-size:13px">@Text["Account.Register"]</a>
            }

            @* Locale switcher stays visible — a Russian speaker landing on a
               Polish page must be able to fix that immediately (018). *@
            <div class="locale">
                @foreach (var l in Locales.Supported)
                {
                    <a href="@InLocale(l)" hreflang="@l" aria-current="@(l == locale ? "true" : "false")">@l.ToUpperInvariant()</a>
                }
            </div>
        </nav>
    </header>

    @* 021 gives panels their own navigation. Rendered here rather than in each
       page so a new section cannot ship unreachable the way every existing one
       did — the layout already knows the path. *@
    @if (path.StartsWith($"/{locale}/org", StringComparison.Ordinal)
         || path.StartsWith($"/{locale}/admin", StringComparison.Ordinal))
    {
        var sections = await Panels.ForAsync(User, locale);
        if (sections.Count > 0)
        {
            <nav class="wrap panelnav" aria-label="@Text["Panel.Title"]">
                @* `section` is a Razor keyword, so the loop variable cannot be called that. *@
                @foreach (var entry in sections)
                {
                    <a href="@entry.Path"
                       aria-current="@(path.StartsWith(entry.Path, StringComparison.Ordinal) ? "page" : "false")">
                        @Text[entry.TextKey]
                    </a>
                }
            </nav>
        }
    }

    <main id="main">
        @RenderBody()
    </main>

    <footer class="wrap footer">
        <div class="footer__cols">
            <div>
                <h4>NEXTSKILL</h4>
                <p class="dim" style="font-size:13px;margin:0">@Text["Meta.Description"]</p>
            </div>
            <div>
                <h4>@Text["Navigation.Tournaments"]</h4>
                <a href="#">@Text["Navigation.Ranking"]</a><a href="#">@Text["Navigation.Tournaments"]</a><a href="#">@Text["Navigation.Lft"]</a><a href="#">@Text["Navigation.Seasons"]</a>
            </div>
            <div>
                <h4>@Text["Footer.Community"]</h4>
                <a href="#">Discord</a><a href="#">@Text["Footer.Forum"]</a><a href="#">@Text["Footer.Rules"]</a><a href="#">FAQ</a>
            </div>
        </div>
        <div class="footer__bottom">
            <span>@Text["Footer.Privacy"] · @Text["Footer.Terms"] · @Text["Footer.Contact"]</span>
            <span>PL EN RU DE</span>
            @* Version makes "which version were you on?" answerable in support
               and confirms a deploy landed (017). *@
            <span>v@(ViewData["Version"] ?? "0.1.0-dev")</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
