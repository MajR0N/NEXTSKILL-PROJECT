@page "{id:guid}"
@model NextSkill.Api.Pages.Teams.DetailsModel
@using NextSkill.Api.Localisation
@using NextSkill.Api.Shared.Persistence
@using NextSkill.Domain.Access
@using NextSkill.Domain.Teams
@using Model = NextSkill.Api.Pages.Teams.DetailsModel
@{
    var team = Model.Team!;
    ViewData["Title"] = team.Name;
    ViewData["Description"] = $"{team.Name} ({team.Tag}) — skład i rating na NEXTSKILL.";
    var locale = Locales.Current;

    @* Whoever pastes this link into Discord is sharing the team, so the card
       has to name the team, not the site (018). *@
}

<div class="wrap section">

    <div class="row" style="gap:var(--s4)">
        <span class="avatar avatar--lg avatar--@Model.Palette(team.Tag)">@Model.Initials(team.Name)</span>
        <div>
            <p class="eyebrow">Drużyna · <b>@team.Tag</b></p>
            <h1 style="margin-top:var(--s1)">@team.Name</h1>
        </div>
    </div>

    @if (Model.Restored)
    {
        <div class="alert alert--ok" role="status" style="margin-top:var(--s5)">
            Drużyna została przywrócona. Poprzedni skład pozostał historią.
        </div>
    }

    @if (team.DisbandedAt is not null)
    {
        <div class="alert" role="status" style="margin-top:var(--s5)">
            <b>Ta drużyna została rozwiązana.</b> Strona i tag pozostają dla historii rozgrywek.
            @if (Model.CanRestore)
            {
                <a class="btn" asp-page="/Teams/Restore" asp-route-culture="@locale" asp-route-id="@team.Id"
                   style="margin-left:var(--s3)">Przywróć drużynę</a>
            }
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert--error" role="alert" style="margin-top:var(--s5)">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="detail-grid" style="margin-top:var(--s7)">
        <div>
            <div class="row" style="justify-content:space-between;margin-bottom:var(--s3)">
                <p class="label" style="margin:0">Skład · @Model.Roster.Count / @RosterRules.MaxTotal</p>
                @if (Model.CanManage)
                {
                    <a class="btn btn--ghost" asp-page="/Teams/Edit" asp-route-culture="@locale" asp-route-id="@team.Id"
                       style="padding:5px 12px;font-size:12.5px">Ustawienia</a>
                }
            </div>

            @if (Model.Roster.Count == 0)
            {
                <div class="empty">
                    <div class="empty__icon">◇</div>
                    <h4>Skład jest pusty</h4>
                    <p>Nikt jeszcze nie przyjął zaproszenia.</p>
                </div>
            }
            else
            {
                @* One section per slot. Grouping is not decoration: a reader has to
                   be able to see who actually plays, and a coach listed among the
                   five would read as a sixth player (045). *@
                foreach (var slot in Enum.GetValues<RosterSlot>())
                {
                    var members = Model.Roster.Where(m => m.Slot == slot).ToList();
                    if (members.Count == 0) { continue; }

                    <p class="label" style="margin-top:var(--s5)">
                        @Model.SlotName(slot) &middot; @members.Count / @RosterRules.Capacity(slot)
                        @if (!RosterRules.IsFieldable(slot))
                        {
                            <span class="dim" style="text-transform:none;letter-spacing:0"> &mdash; nie gra w meczach</span>
                        }
                    </p>
                <div class="table-scroll">
                    <table class="table table--dense">
                        <tbody>
                            @foreach (var member in members)
                            {
                                <tr>
                                    <td>
                                        <div class="team">
                                            <span class="avatar avatar--sm avatar--@Model.Palette(member.Nickname)">@Model.Initials(member.Nickname)</span>
                                            <a class="team__name" asp-page="/Players/Details" asp-route-culture="@locale"
                                               asp-route-id="@member.AccountId" style="color:inherit">@member.Nickname</a>
                                        </div>
                                    </td>
                                    <td class="dim">@(member.Role == TeamRole.Captain ? "Kapitan" : "Zawodnik")</td>
                                    <td class="r">
                                        @if (Model.CanManage && member.Role != TeamRole.Captain)
                                        {
                                            <div class="row" style="justify-content:flex-end">
                                                @* Moving between slots is what a bench is FOR. Without it a
                                                   one-week absence would have to be a removal (045). *@
                                                @foreach (var target in Enum.GetValues<RosterSlot>().Where(s => s != member.Slot && Model.PlacesLeft(s) > 0))
                                                {
                                                    <form method="post" asp-page-handler="Slot" asp-route-culture="@locale"
                                                          asp-route-id="@team.Id" asp-route-accountId="@member.AccountId"
                                                          asp-route-slot="@target">
                                                        <button class="btn btn--ghost" type="submit"
                                                                style="padding:5px 11px;font-size:12.5px">&rarr; @Model.SlotName(target)</button>
                                                    </form>
                                                }
                                                @* Without this, the "hand over the captaincy first" message
                                                   the last captain sees points at nothing. *@
                                                <form method="post" asp-page-handler="Promote" asp-route-culture="@locale"
                                                      asp-route-id="@team.Id" asp-route-accountId="@member.AccountId">
                                                    <button class="btn btn--ghost" type="submit"
                                                            style="padding:5px 11px;font-size:12.5px">Mianuj kapitanem</button>
                                                </form>
                                                @* Destructive, so it is a POST and it is signed (012, 020). *@
                                                <form method="post" asp-page-handler="Remove" asp-route-culture="@locale"
                                                      asp-route-id="@team.Id" asp-route-accountId="@member.AccountId">
                                                    <button class="btn btn--danger" type="submit"
                                                            style="padding:5px 11px;font-size:12.5px">Usuń</button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            }

            @if (Model.Invited.Count > 0)
            {
                @* Pending invites are shown SEPARATELY and never counted as
                   roster — an invited player is not a player yet, and a roster
                   that quietly includes them would misstate who can play. *@
                <p class="label" style="margin-top:var(--s6)">Zaproszeni · czekają na odpowiedź</p>
                <div class="stack">
                    @foreach (var member in Model.Invited)
                    {
                        <div class="card row" style="justify-content:space-between;padding:var(--s3) var(--s4)">
                            <div class="team">
                                <span class="avatar avatar--sm avatar--@Model.Palette(member.Nickname)" style="opacity:.55">@Model.Initials(member.Nickname)</span>
                                <span class="dim">@member.Nickname <span style="font-size:11px">&middot; @Model.SlotName(member.Slot)</span></span>
                            </div>
                            @if (Model.CanManage)
                            {
                                <form method="post" asp-page-handler="Remove" asp-route-culture="@locale"
                                      asp-route-id="@team.Id" asp-route-accountId="@member.AccountId">
                                    <button class="btn btn--ghost" type="submit"
                                            style="padding:5px 11px;font-size:12.5px">Cofnij</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }

            @if (Model.CanManage)
            {
                <div class="card" style="margin-top:var(--s6)">
                    <p class="label">Zaproś gracza</p>
                    @if (!Model.AnyPlaceLeft)
                    {
                        <p class="lede" style="margin-top:0">
                            Wszystkie miejsca zajęte. Zwolnij miejsce, zanim zaprosisz kogoś nowego.
                        </p>
                    }
                    <form method="post" asp-page-handler="Invite" asp-route-culture="@locale" asp-route-id="@team.Id">
                        <div class="field">
                            <label asp-for="InviteNickname">Nick gracza</label>
                            <input class="input" asp-for="InviteNickname" maxlength="32" required
                                   autocomplete="off" placeholder="np. Pukawka" />
                            <span class="field__hint">Gracz musi mieć konto na NEXTSKILL i sam przyjąć zaproszenie.</span>
                            <span class="field__error" asp-validation-for="InviteNickname"></span>
                        </div>
                        <div class="field">
                            <label asp-for="InviteSlot">Rola</label>
                            @* Only slots with room are offered — an option that always
                               fails is worse than no option (020). *@
                            <select class="input" asp-for="InviteSlot">
                                @foreach (var slot in Enum.GetValues<RosterSlot>().Where(s => Model.PlacesLeft(s) > 0))
                                {
                                    <option value="@slot">@Model.SlotName(slot) — @Model.PlacesLeft(slot) wolnych</option>
                                }
                            </select>
                        </div>

                        <button class="btn btn--primary" type="submit" disabled="@(!Model.AnyPlaceLeft)">Wyślij zaproszenie</button>
                    </form>
                </div>
            }
            else if (Model.IsMember)
            {
                <form method="post" asp-page-handler="Leave" asp-route-culture="@locale" asp-route-id="@team.Id"
                      style="margin-top:var(--s6)">
                    <button class="btn btn--danger" type="submit">Opuść drużynę</button>
                </form>
            }

            @* ── competitive history, per game (049) ───────────────────── *@
            <section style="margin-top:var(--s7)" aria-labelledby="history-heading">
                <p class="label" id="history-heading">Historia meczów</p>

                @* One game at a time. A record mixing CS2 and CS 1.6 describes
                   nobody, and the choice stays in the URL so the link someone
                   pastes into Discord shows what they were looking at. *@
                <div class="row" style="margin-top:var(--s3)">
                    <a asp-route-id="@team.Id" asp-route-culture="@locale" asp-route-game="Cs2"
                       aria-current="@(Model.HistoryGame == Game.Cs2 ? "true" : "false")">CS2</a>
                    <a asp-route-id="@team.Id" asp-route-culture="@locale" asp-route-game="Cs16"
                       aria-current="@(Model.HistoryGame == Game.Cs16 ? "true" : "false")">CS 1.6</a>
                </div>

                @if (Model.History.Count == 0)
                {
                    <p class="dim" style="margin-top:var(--s4)">
                        Brak rozstrzygniętych meczów w tej grze. Historia zapisuje się sama, gdy serwer zgłosi wynik.
                    </p>
                }
                else
                {
                    <p style="margin-top:var(--s4)">
                        Bilans: <b>@Model.Wins — @Model.Losses</b>
                        @if (Model.UncountedResults > 0)
                        {
                            @* Named, not hidden: a record that quietly drops
                               matches is one nobody can reconcile. *@
                            <span class="dim">
                                · @Model.UncountedResults @(Model.UncountedResults == 1 ? "wynik" : "wyniki")
                                poza bilansem do czasu wyjaśnienia
                            </span>
                        }
                    </p>

                    <div class="table-scroll" style="margin-top:var(--s4)">
                        <table class="table">
                            <caption class="visually-hidden">Historia meczów drużyny</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Wynik</th>
                                    <th scope="col">Przeciwnik</th>
                                    <th scope="col">Data</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.History)
                                {
                                    <tr>
                                        <td>
                                            <b>@(row.Won ? "W" : "L")</b>
                                            @if (row.OwnScore is not null)
                                            {
                                                <span class="dim"> @row.OwnScore : @row.OpponentScore</span>
                                            }
                                            @if (row.Forfeit)
                                            {
                                                <span class="dim"> · walkower</span>
                                            }
                                            @if (row.Integrity != NextSkill.Domain.Matches.MatchIntegrity.Confirmed)
                                            {
                                                <span class="dim"> · niepotwierdzony</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-page="/Matches/Details" asp-route-culture="@locale" asp-route-id="@row.MatchId">
                                                @row.Opponent
                                            </a>
                                        </td>
                                        <td class="dim">@(row.EndedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (Model.Trend.Count > 0)
            {
                <section style="margin-top:var(--s7)" aria-labelledby="trend-heading">
                    <p class="label" id="trend-heading">Zmiany ratingu</p>
                    @* 049 asks for an ACCESSIBLE trend, so the trend IS a table.
                       A chart drawn over it is a Phase 5 enhancement; a chart
                       INSTEAD of it would be a number only sighted mouse users
                       can read. Values come from the append-only ledger, so an
                       old rating is quoted rather than reconstructed. *@
                    <div class="table-scroll" style="margin-top:var(--s4)">
                        <table class="table">
                            <caption class="visually-hidden">Rating po każdym rozliczonym meczu</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Data</th>
                                    <th scope="col" class="r">Rating</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var point in Model.Trend.Reverse())
                                {
                                    <tr>
                                        <td class="dim">@point.At.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="r num">
                                            @point.Value.ToString("F0")<span class="rating__rd"> ±@point.Deviation.ToString("F0")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>

        @* Meta rail carries FACTS, never actions (041). *@
        <aside>
            <p class="label">Rating</p>
            <div class="rail">
                @foreach (var (label, rating) in new[] { ("CS2", Model.Cs2), ("CS 1.6", Model.Cs16) })
                {
                    <div>
                        <span>@label</span>
                        <span>
                            @if (rating is null)
                            {
                                <span class="dim">brak meczów</span>
                            }
                            else
                            {
                                @rating.Value.ToString("F0")<span class="rating__rd"> ±@rating.Deviation.ToString("F0")</span>
                                @if (Model.IsProvisional(rating))
                                {
                                    <span class="dim" style="font-size:11px"> · wstępny</span>
                                }
                            }
                        </span>
                    </div>
                }
                <div><span>Założona</span><span>@team.CreatedAt.ToString("yyyy-MM-dd")</span></div>
                @if (!string.IsNullOrWhiteSpace(team.City))
                {
                    <div><span>Miasto</span><span>@team.City</span></div>
                }
                @foreach (var slot in Enum.GetValues<RosterSlot>())
                {
                    <div>
                        <span>@Model.SlotName(slot)</span>
                        <span>@Model.Roster.Count(m => m.Slot == slot) / @RosterRules.Capacity(slot)</span>
                    </div>
                }
            </div>

            <p class="lede" style="font-size:13px">
                Rating pojawia się po pierwszym rozstrzygniętym meczu.
                <b>±</b> pokazuje, jak pewny jest wynik.
            </p>
        </aside>
    </div>
</div>
