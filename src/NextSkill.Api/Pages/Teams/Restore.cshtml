@page "{id:guid}/restore"
@model NextSkill.Api.Pages.Teams.RestoreModel
@using NextSkill.Api.Localisation
@{
    var team = Model.Team!;
    var locale = Locales.Current;
    ViewData["Title"] = $"Przywróć — {team.Name}";
}

<div class="wrap-narrow section">
    <p class="eyebrow">Drużyna · <b>@team.Tag</b></p>
    <h1>Przywróć drużynę</h1>

    <div class="card" style="margin-top:var(--s6)">
        <p class="lede" style="margin-top:0">
            Przywrócisz ten sam identyfikator, nazwę i zarezerwowany tag.
            Poprzedni skład pozostanie historią — wrócisz tylko Ty jako kapitan,
            a pozostałych graczy zaprosisz ponownie za ich zgodą.
        </p>

        <form method="post" asp-route-culture="@locale" asp-route-id="@team.Id" style="margin-top:var(--s4)">
            <div class="field">
                <label asp-for="ConfirmTag">Wpisz <b>@team.Tag</b>, żeby potwierdzić</label>
                <input class="input" asp-for="ConfirmTag" autocomplete="off" placeholder="@team.Tag" required />
                <span class="field__error" asp-validation-for="ConfirmTag"></span>
            </div>
            <div class="row">
                <button class="btn btn--primary" type="submit">Przywróć drużynę</button>
                <a class="btn btn--ghost" asp-page="/Teams/Details" asp-route-culture="@locale"
                   asp-route-id="@team.Id">Anuluj</a>
            </div>
        </form>
    </div>
</div>
