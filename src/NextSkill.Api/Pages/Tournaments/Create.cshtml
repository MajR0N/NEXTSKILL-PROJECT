@page
@model NextSkill.Api.Pages.Tournaments.CreateModel
@using NextSkill.Api.Shared.Persistence
@using NextSkill.Domain.Tournaments
@using L = NextSkill.Api.Pages.Tournaments.IndexModel
@{
    ViewData["Title"] = "Utwórz turniej";
}

<div class="wrap-narrow section">

    <p class="eyebrow">Organizator</p>
    <h1>Utwórz turniej</h1>
    <p class="lede">
        Turniej powstaje jako <b>szkic</b> — widzisz go tylko Ty.
        Zapisy otwierasz wtedy, kiedy strona jest gotowa.
    </p>

    @if (Model.Templates.Count > 0)
    {
        <div class="card" style="margin-top:var(--s6)">
            <p class="label">Szablony organizatora</p>
            <p class="lede" style="font-size:13px">
                Szablon kopiuje ustawienia do nowego szkicu. Późniejsze zmiany nie łączą obu rekordów.
            </p>
            <div class="stack">
                @foreach (var template in Model.Templates)
                {
                    <div class="row" style="justify-content:space-between;align-items:center">
                        <span>
                            <span class="team__name">@template.Name</span>
                            <span class="team__meta">
                                @if (Model.Organisers.Count > 1) { <span>@template.Organiser</span> }
                                <span>@L.FormatName(template.Format)</span>
                                <span>@L.Size(template.TeamSize)</span>
                                <span>do @template.MaxTeams drużyn</span>
                            </span>
                        </span>
                        <span class="row">
                            <a class="btn" asp-page="/Tournaments/Create" asp-route-culture="@NextSkill.Api.Localisation.Locales.Current"
                               asp-route-templateId="@template.Id">Użyj</a>
                            <form method="post" asp-page-handler="DeleteTemplate"
                                  asp-route-culture="@NextSkill.Api.Localisation.Locales.Current"
                                  asp-route-templateId="@template.Id">
                                <button class="btn btn--danger" type="submit">Usuń</button>
                            </form>
                        </span>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.AppliedTemplateName is not null)
    {
        <div class="alert" role="status" style="margin-top:var(--s5)">
            Skopiowano ustawienia z szablonu <b>@Model.AppliedTemplateName</b>.
            Nadaj turniejowi nazwę i termin, a potem możesz zmienić każde pole.
        </div>
    }

    <form method="post" class="card" style="margin-top:var(--s6)">
        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert--error" role="alert" style="margin-bottom:var(--s4)">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="field">
            <label asp-for="Input.Name">Nazwa</label>
            <input class="input" asp-for="Input.Name" maxlength="120" required autofocus autocomplete="off" />
            <span class="field__error" asp-validation-for="Input.Name"></span>
        </div>

        @* One organiser is the common case; the picker only earns its place
           when somebody actually runs more than one. *@
        @if (Model.Organisers.Count == 1)
        {
            <input type="hidden" asp-for="Input.OrganiserId" value="@Model.Organisers[0].Id" />
        }
        else
        {
            <div class="field">
                <label asp-for="Input.OrganiserId">Organizator</label>
                <select class="input" asp-for="Input.OrganiserId">
                    @foreach (var organiser in Model.Organisers)
                    {
                        <option value="@organiser.Id">@organiser.Name</option>
                    }
                </select>
            </div>
        }

        <div class="field">
            <label asp-for="Input.Game">Gra</label>
            <select class="input" asp-for="Input.Game">
                <option value="@Game.Cs2">CS2</option>
                <option value="@Game.Cs16">CS 1.6</option>
            </select>
        </div>

        <div class="field">
            <label asp-for="Input.TeamSize">Skład</label>
            <select class="input" asp-for="Input.TeamSize">
                @foreach (var size in Enum.GetValues<TeamSize>())
                {
                    <option value="@size">@L.Size(size)</option>
                }
            </select>
            <span class="field__hint">Drużyna musi mieć tylu zawodników mogących grać, żeby się zapisać. Sztab się nie liczy.</span>
        </div>

        <div class="field">
            <label asp-for="Input.Format">Format</label>
            @* Only formats that actually generate a bracket today (022). *@
            <select class="input" asp-for="Input.Format">
                @foreach (var format in NextSkill.Api.Pages.Tournaments.CreateModel.BuildableFormats)
                {
                    <option value="@format">@L.FormatName(format)</option>
                }
            </select>
            <span class="field__error" asp-validation-for="Input.Format"></span>
        </div>

        <div class="field">
            <label asp-for="Input.MaxTeams">Limit drużyn</label>
            <input class="input" asp-for="Input.MaxTeams" type="number" min="2" max="128" required />
            <span class="field__error" asp-validation-for="Input.MaxTeams"></span>
        </div>

        @if (Model.Seasons.Count > 0)
        {
            <div class="field">
                <label asp-for="Input.SeasonId">Sezon</label>
                <select class="input" asp-for="Input.SeasonId">
                    <option value="">Poza sezonem</option>
                    @foreach (var season in Model.Seasons)
                    {
                        <option value="@season.Id">
                            @season.Name · od @season.StartsAt.ToString("yyyy-MM-dd")@(season.EndsAt is { } end ? $" do {end:yyyy-MM-dd}" : "")
                        </option>
                    }
                </select>
                <span class="field__hint">Zamknięte sezony są zamrożonym archiwum i nie przyjmują nowych turniejów.</span>
                <span class="field__error" asp-validation-for="Input.SeasonId"></span>
            </div>
        }

        <div class="field">
            <label asp-for="Input.StartsAt">Start <span class="dim">— opcjonalnie</span></label>
            @* Native date input rather than a picker library: it is already
               localised, keyboard-accessible and works without JavaScript. *@
            <input class="input" asp-for="Input.StartsAt" type="date" />
        </div>

        <div class="field">
            <label asp-for="Input.Description">Opis <span class="dim">— zasady, nagrody, kontakt</span></label>
            <textarea class="input" asp-for="Input.Description" rows="5" maxlength="4000"></textarea>
        </div>

        <button class="btn btn--primary" type="submit" style="width:100%;justify-content:center">
            Utwórz szkic
        </button>
    </form>
</div>
